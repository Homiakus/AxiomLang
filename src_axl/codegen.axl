require [Memory, IO]

fn stage1_find_substr_end(src: str, start: int) -> int {
    let n = len(src)
    let mut i = start
    while i < n && char_at(src, i) != 34 {
        i = i + 1
    }
    return i
}

fn stage1_match_kw_at(src: str, pos: int, kw: str) -> int {
    let n = len(src)
    let klen = len(kw)
    if pos + klen > n {
        return 0
    }
    let mut j = 0
    while j < klen {
        if char_at(src, pos + j) != char_at(kw, j) {
            return 0
        }
        j = j + 1
    }
    return 1
}

fn stage1_find_char(src: str, ch: int) -> str {
    let n = len(src)
    let mut i = 0
    while i < n {
        if char_at(src, i) == ch {
            return substr(src, i, 1)
        }
        i = i + 1
    }
    return ""
}

fn stage1_digit_str(d: int) -> str {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

fn stage1_idx_str(idx: int) -> str {
    if idx < 10 {
        return stage1_digit_str(idx)
    }
    let mut n = idx
    let mut res = ""
    while n > 0 {
        let q = n / 10
        let rem = n - q * 10
        res = stage1_digit_str(rem) + res
        n = q
    }
    return res
}

fn stage1_compile_to_asm(src: str) -> str {
    let n = len(src)
    let nl = stage1_find_char(src, 10)
    let q = stage1_find_char(src, 34)
    let mut i = 0
    let mut text_sec = ".global _start" + nl + ".section .text" + nl + "_start:" + nl
    let mut rodata_sec = ".section .rodata" + nl
    let mut str_idx = 0

    while i < n {
        if stage1_match_kw_at(src, i, "//") == 1 {
            while i < n && char_at(src, i) != 10 {
                i = i + 1
            }
        } else if stage1_match_kw_at(src, i, "println(") == 1 && i + 8 < n && char_at(src, i + 8) == 34 {
            let s_start = i + 9
            let s_end = stage1_find_substr_end(src, s_start)
            let lit = substr(src, s_start, s_end - s_start)
            let idx_str = stage1_idx_str(str_idx)
            let lbl = "s1_str_" + idx_str
            text_sec = text_sec + "    movq $1, %rax" + nl + "    movq $1, %rdi" + nl
            text_sec = text_sec + "    leaq " + lbl + "(%rip), %rsi" + nl
            text_sec = text_sec + "    movq $" + lbl + "_len, %rdx" + nl + "    syscall" + nl
            rodata_sec = rodata_sec + lbl + ": .ascii " + q + lit + q + nl + "    .byte 10" + nl
            rodata_sec = rodata_sec + lbl + "_len = . - " + lbl + nl
            str_idx = str_idx + 1
            i = s_end + 1
        } else if stage1_match_kw_at(src, i, "print(") == 1 && i + 6 < n && char_at(src, i + 6) == 34 {
            let s_start = i + 7
            let s_end = stage1_find_substr_end(src, s_start)
            let lit = substr(src, s_start, s_end - s_start)
            let idx_str = stage1_idx_str(str_idx)
            let lbl = "s1_str_" + idx_str
            text_sec = text_sec + "    movq $1, %rax" + nl + "    movq $1, %rdi" + nl
            text_sec = text_sec + "    leaq " + lbl + "(%rip), %rsi" + nl
            text_sec = text_sec + "    movq $" + lbl + "_len, %rdx" + nl + "    syscall" + nl
            rodata_sec = rodata_sec + lbl + ": .ascii " + q + lit + q + nl
            rodata_sec = rodata_sec + lbl + "_len = . - " + lbl + nl
            str_idx = str_idx + 1
            i = s_end + 1
        } else {
            i = i + 1
        }
    }

    text_sec = text_sec + "    movq $60, %rax" + nl + "    xorq %rdi, %rdi" + nl + "    syscall" + nl
    return text_sec + rodata_sec
}
