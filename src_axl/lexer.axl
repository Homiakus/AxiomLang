require [Memory, IO]

fn is_space_ch(c: int) -> int {
    if c == 32 || c == 9 || c == 13 || c == 10 {
        return 1
    }
    return 0
}

fn is_alpha_ch(c: int) -> int {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
        return 1
    }
    return 0
}

fn is_digit_ch(c: int) -> int {
    if c >= 48 && c <= 57 {
        return 1
    }
    return 0
}

fn stage1_count_tokens(src: str) -> int {
    let n = len(src)
    let mut i = 0
    let mut tokens = 0
    while i < n {
        let c = char_at(src, i)
        if is_space_ch(c) == 1 {
            i = i + 1
        } else if c == 47 && i + 1 < n && char_at(src, i + 1) == 47 {
            while i < n && char_at(src, i) != 10 {
                i = i + 1
            }
        } else if c == 34 {
            tokens = tokens + 1
            i = i + 1
            while i < n && char_at(src, i) != 34 {
                i = i + 1
            }
            if i < n {
                i = i + 1
            }
        } else if is_alpha_ch(c) == 1 {
            tokens = tokens + 1
            while i < n && (is_alpha_ch(char_at(src, i)) == 1 || is_digit_ch(char_at(src, i)) == 1) {
                i = i + 1
            }
        } else if is_digit_ch(c) == 1 {
            tokens = tokens + 1
            while i < n && is_digit_ch(char_at(src, i)) == 1 {
                i = i + 1
            }
        } else {
            tokens = tokens + 1
            i = i + 1
        }
    }
    return tokens
}
