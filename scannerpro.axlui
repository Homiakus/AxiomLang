{
  "file_path": "scannerpro.axlui",
  "title": "ScannerPRO Precision Microscopy Console",
  "theme": "GlassDark",
  "root": {
    "id": "viewport_root",
    "tag": "div",
    "text": "",
    "style": {
      "width": 1920,
      "height": 1080,
      "background": "radial-gradient(circle at 50% 0%, #1e1b4b 0%, #030712 100%)",
      "backdrop_blur": 24,
      "border_radius": 16,
      "border_color": "rgba(56, 189, 248, 0.2)",
      "box_shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.5)",
      "color": "#f8fafc",
      "padding": "24px",
      "flex_direction": "column",
      "align_items": "center",
      "justify_content": "flex-start",
      "gap": "20px"
    },
    "children": [
      {
        "id": "header_bar",
        "tag": "div",
        "text": "",
        "style": {
          "width": 1872,
          "height": 70,
          "background": "rgba(15, 23, 42, 0.85)",
          "backdrop_blur": 20,
          "border_radius": 12,
          "border_color": "rgba(56, 189, 248, 0.3)",
          "padding": "16px",
          "flex_direction": "row",
          "align_items": "center",
          "justify_content": "space-between"
        },
        "children": [
          {
            "id": "brand_badge",
            "tag": "text",
            "text": "SCANNERPRO SPECTRUM · AXIOM PRECISION CONSOLE",
            "style": {
              "font_size": 20,
              "font_weight": "800",
              "color": "#38bdf8"
            }
          },
          {
            "id": "hardware_pills_row",
            "tag": "div",
            "style": {
              "width": 600,
              "height": 45,
              "flex_direction": "row",
              "gap": "16px"
            },
            "children": [
              {
                "id": "camera_pill",
                "tag": "text",
                "text": "● CAMERA: Tucsen MIchrome 6 (Native SDK - 20 FPS)",
                "style": {
                  "font_size": 13,
                  "font_weight": "700",
                  "color": "#4ade80"
                }
              },
              {
                "id": "cnc_pill",
                "tag": "text",
                "text": "● STAGE: GRBL CNC Connected (Zero Backlash)",
                "style": {
                  "font_size": 13,
                  "font_weight": "700",
                  "color": "#38bdf8"
                }
              }
            ]
          },
          {
            "id": "btn_estop",
            "tag": "button",
            "text": "⚠ EMERGENCY STOP (F12)",
            "style": {
              "width": 220,
              "height": 44,
              "background": "linear-gradient(135deg, #e11d48, #be123c)",
              "border_radius": 8,
              "color": "#ffffff",
              "font_size": 13,
              "font_weight": "700"
            }
          }
        ]
      },
      {
        "id": "main_content_grid",
        "tag": "div",
        "style": {
          "width": 1872,
          "height": 920,
          "flex_direction": "row",
          "justify_content": "space-between",
          "gap": "24px"
        },
        "children": [
          {
            "id": "live_viewport_card",
            "tag": "div",
            "style": {
              "width": 1280,
              "height": 920,
              "background": "rgba(3, 7, 18, 0.95)",
              "backdrop_blur": 24,
              "border_radius": 16,
              "border_color": "rgba(56, 189, 248, 0.4)",
