require [Math, Memory, IO]

intent "Integration Test 06: String variables, collection for-in loop, and field/index mutation"

struct Box {
    w: int,
    h: int
}

fn main() {
    let msg = "AxiomStr"
    println(msg)
    println(len(msg))

    let b = { w: 3, h: 4 }
    b.w = 10
    println(b.w * b.h)

    let arr = [1, 2, 3]
    arr[1] = 20
    let mut sum = 0
    for item in arr {
        sum = sum + item
    }
    println(sum)
    return 0
}
