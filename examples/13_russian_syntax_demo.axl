// 13_russian_syntax_demo.axl — Полностью русскоязычный синтаксис AxiomLang

требовать мандат[Console.Out]

структура МетрикаКластера {
    имя_узла: string,
    нагрузка_цпу: int
}

функция рассчитать_безопасность(база: int, множитель: int) -> int {
    пусть результат = база * множитель + 100;
    вернуть результат;
}

намерение "Демонстрация русскоязычного кода и мандатной модели" {
    пусть изм статус = "Активен";
    пусть надежность = рассчитать_безопасность(50, 4);

    если надежность > 200 {
        print("✅ Кластер полностью защищен математическими инвариантами!");
    } иначе {
        print("⚠️ Требуется выделение ресурсов.");
    }
}
