{
  "file_path": "examples/11_axiom_quantum_os_monitor.axlui",
  "title": "Axiom Quantum OS Dashboard",
  "theme": "GlassDark",
  "root": {
    "id": "quantum_monitor_root",
    "tag": "div",
    "text": "",
    "style": {
      "width": 1440,
      "height": 900,
      "background": "radial-gradient(circle at 50% 0%, #1e1b4b 0%, #030712 100%)",
      "backdrop_blur": 32,
      "border_radius": 20,
      "border_color": "rgba(255, 255, 255, 0.15)",
      "box_shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.7)",
      "color": "#f8fafc",
      "font_size": 16,
      "padding": "32px",
      "flex_direction": "column",
      "align_items": "center",
      "justify_content": "space-between"
    },
    "children": [
      {
        "id": "header_panel",
        "tag": "div",
        "text": "",
        "style": {
          "width": 1360,
          "height": 80,
          "background": "rgba(15, 23, 42, 0.6)",
          "backdrop_blur": 16,
          "border_radius": 12,
          "border_color": "rgba(56, 189, 248, 0.2)",
          "color": "#38bdf8",
          "font_size": 26,
          "padding": "16px",
          "flex_direction": "row",
          "align_items": "center",
          "justify_content": "space-between"
        },
        "children": [
          {
            "id": "title_text",
            "tag": "text",
            "text": "🛡️ Axiom Quantum OS Cluster Monitor (120 FPS)",
            "style": {
              "font_size": 24,
              "color": "#38bdf8"
            }
          },
          {
            "id": "status_badge",
            "tag": "button",
            "text": "SEALED & PROVED",
            "style": {
              "width": 180,
              "height": 38,
              "background": "linear-gradient(135deg, #10b981, #059669)",
              "border_radius": 8,
              "color": "#ffffff",
              "font_size": 13
            }
          }
        ]
      },
      {
        "id": "metrics_grid",
        "tag": "div",
        "text": "",
        "style": {
          "width": 1360,
          "height": 580,
          "background": "transparent",
          "flex_direction": "row",
          "justify_content": "space-between",
          "align_items": "center"
        },
        "children": [
          {
            "id": "card_cpu",
            "tag": "div",
            "text": "CPU Load: 18% (Zero GC Jitter)",
            "style": {
              "width": 420,
              "height": 500,
              "background": "rgba(30, 41, 59, 0.7)",
              "backdrop_blur": 20,
              "border_radius": 16,
              "border_color": "rgba(255, 255, 255, 0.1)",
              "color": "#e2e8f0",
              "font_size": 18,
              "padding": "24px"
            }
          },
          {
            "id": "card_lwe",
            "tag": "div",
            "text": "LWE Lattice Entropy: 2048-bit Sealed",
            "style": {
              "width": 420,
              "height": 500,
              "background": "rgba(30, 41, 59, 0.7)",
              "backdrop_blur": 20,
              "border_radius": 16,
              "border_color": "rgba(168, 85, 247, 0.3)",
              "color": "#c084fc",
              "font_size": 18,
              "padding": "24px"
            }
          },
          {
            "id": "card_actors",
            "tag": "div",
            "text": "Actor Supervision Tree: 100k msg/sec Active",
            "style": {
              "width": 420,
              "height": 500,
              "background": "rgba(30, 41, 59, 0.7)",
              "backdrop_blur": 20,
              "border_radius": 16,
              "border_color": "rgba(56, 189, 248, 0.3)",
              "color": "#38bdf8",
              "font_size": 18,
              "padding": "24px"
            }
          }
        ]
      }
    ]
  }
}
