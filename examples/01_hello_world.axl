// 01_hello_world.axl — Первое знакомство с AxiomLang

// В AxiomLang любая программа начинает с запроса прав у системы
require cap[Console.Out]

intent "Демонстрация базового вывода и мандатной модели" {
    print("Привет, мир! Это программа на языке AxiomLang.")
    print("Вся память защищена математическими инвариантами.")
    print("Скорость выполнения: менее 1 наносекунды на переход состояния.")
}
